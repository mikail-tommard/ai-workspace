# Export variables in your shell; .env is not loaded automatically.
WORKSPACE_TRANSPORT=http
WORKSPACE_ADDR=127.0.0.1:8080
WORKSPACE_DATA_DIR=.ai-workspace
# Optional: >=32 characters. Otherwise generated once in DATA_DIR/mcp-token.
# WORKSPACE_TOKEN=
# Uses the Codex CLI already installed and signed in on this Mac.
# Optional when codex is absent from the server's PATH:
# WORKSPACE_CODEX_BIN=/absolute/path/to/codex
# OPENAI_API_KEY / OpenAI Realtime are not used by the built-in assistant.
# Native notification test: ./ai-workspace --notify-test
# Real Codex tool test without HTTP: ./ai-workspace --codex-check --data-dir .cache/codex-check

# Local imports always allow the server cwd and ~/.codex/generated_images.
# Optional EXTRA absolute roots, separated by : on macOS/Linux:
# WORKSPACE_MEDIA_IMPORT_ROOTS=/absolute/path/to/photos:/absolute/path/to/documents
# Files are copied into WORKSPACE_DATA_DIR/media; back up the entire data directory.
